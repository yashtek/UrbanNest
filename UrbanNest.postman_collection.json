  "item": [
    {
      "name": "Auth",
      "description": "Signup, login, profile, token, and password reset routes. Use these before calling protected endpoints.",
      "item": [
        {
          "name": "POST Send Signup OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-signup-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-signup-otp"
              ]
            },
            "description": "Send an OTP to a phone number before signup."
          }
        },
        {
          "name": "POST Verify Signup OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-signup-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-signup-otp"
              ]
            },
            "description": "Verify the OTP before completing signup."
          }
        },
        {
          "name": "POST Complete Signup",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"verificationToken\": \"{{verificationToken}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"fullName\": \"Test User\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/complete-signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "complete-signup"
              ]
            },
            "description": "Create the account after OTP verification."
          }
        },
        {
          "name": "POST Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"asha_p\",\n  \"password\": \"StrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login and receive the user object plus access token. Save the returned token in `accessToken`."
          }
        },
        {
          "name": "POST Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalidate the current access token by bumping token version."
          }
        },
        {
          "name": "GET Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Get the authenticated user's profile."
          }
        },
        {
          "name": "GET Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            },
            "description": "Get the authenticated user's profile for the post-login profile screen."
          }
        },
        {
          "name": "PATCH Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha P\",\n  \"username\": \"asha_p1\",\n  \"email\": \"asha@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            },
            "description": "Update the authenticated user's profile. Provide at least one field. Set `email` to `null` to remove it. Returns a fresh access token."
          }
        },
        {
          "name": "GET Verify Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-token"
              ]
            },
            "description": "Validate the current token and return its expiry time."
          }
        },
        {
          "name": "GET Check Username",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/check-username?username=asha_p",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "check-username"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "asha_p"
                }
              ]
            },
            "description": "Check whether a username is available."
          }
        },
        {
          "name": "POST Forgot Password Send OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password",
                "send-otp"
              ]
            },
            "description": "Send a password reset OTP if the account exists."
          }
        },
        {
          "name": "POST Forgot Password Verify OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password",
                "verify-otp"
              ]
            },
            "description": "Verify the reset OTP before allowing a password change."
          }
        },
        {
          "name": "POST Forgot Password Reset",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"password\": \"NewStrongPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password",
                "reset"
              ]
            },
            "description": "Reset the password after OTP verification."
          }
        }
      ]
    },
