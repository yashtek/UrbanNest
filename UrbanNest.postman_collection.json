                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/business/{{businessId}}/rooms/{{roomId}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "business",
                "{{businessId}}",
                "rooms",
                "{{roomId}}",
                "images"
              ]
            },
            "description": "Upload one or more new room images. Send multipart form-data with `images` file fields."
          }
        },
