    {
      "name": "Rooms",
      "description": "Room CRUD and image management routes.",
      "item": [
        {
          "name": "POST Create Room",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "roomNumber",
                  "value": "101",
                  "type": "text"
                },
                {
                  "key": "floor",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "capacity",
                  "value": "4",
                  "type": "text"
                },
                {
                  "key": "rent",
                  "value": "8000",
                  "type": "text"
                },
                {
                  "key": "electricity",
                  "value": "1200",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/business/{{businessId}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "business",
                "{{businessId}}",
                "rooms"
              ]
            },
            "description": "Create a room inside a business. Send multipart form-data. `images` is optional and can be repeated to upload multiple files."
          }
        },
        {
          "name": "GET List Rooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/business/{{businessId}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "business",
                "{{businessId}}",
                "rooms"
              ]
            },
            "description": "List all rooms for a business."
          }
        },
        {
          "name": "PATCH Update Room",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"102\",\n  \"floor\": 1,\n  \"capacity\": 4,\n  \"occupied\": 1,\n  \"rent\": 8500,\n  \"electricity\": 1300,\n  \"status\": \"NOT_FULL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/business/{{businessId}}/rooms/{{roomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "business",
                "{{businessId}}",
                "rooms",
                "{{roomId}}"
              ]
            },
            "description": "Update a room by id. The controller also accepts multipart form-data if you want to change photos."
          }
        },
        {
          "name": "POST Add Room Images",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
