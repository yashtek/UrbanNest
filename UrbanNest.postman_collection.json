{
  "info": {
    "_postman_id": "3b8d8b1c-0f3a-4b6d-9b33-7a5cf0c3a0f1",
    "name": "Umanage API",
    "description": "Umanage REST API collection. Set `baseUrl` to your local or deployed URL and store the logged-in user's access token in `accessToken`. All non-auth routes require a Bearer token.\n\nProtected endpoints:\n- Business\n- Rooms\n- Tenants\n- Rents\n- Electricity\n- Staff\n- Staff duties\n- Staff expenses\n- Misc expenses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
